---
import '@fontsource-variable/onest';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '../styles/global.css';
import { ui, href, other, type Lang } from '../i18n/ui';

interface Props { lang: Lang; title?: string; description?: string; path: string }
const { lang, title, description, path } = Astro.props;
const s = ui[lang];
const fullTitle = title ? `${title} · ${s.siteTitle}` : s.siteTitle;
const alt = other(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? s.tagline} />
    <link rel="alternate" hreflang={alt} href={href(`/${alt}${path}`)} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        var th = localStorage.getItem('theme');
        if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={href(`/${lang}/`)}>
          <svg viewBox="0 0 28 28" width="28" height="28" aria-hidden="true"><path class="w1" d="M2 14 Q8 0 14 14 T26 14" fill="none" stroke-width="2.2" stroke-linecap="round"/><path class="w5" d="M2 14 Q8 28 14 14 T26 14" fill="none" stroke-width="2.2" stroke-linecap="round"/><circle class="wc" cx="14" cy="14" r="2.4"/></svg>
          <span>{s.siteTitle}</span>
        </a>
        <nav aria-label="Main">
          <a href={href(`/${lang}/`)} aria-current={path === '/' ? 'page' : undefined}><span class="nav-num">01</span>{s.course}</a>
          <a href={href(`/${lang}/tools/`)} aria-current={path === '/tools/' ? 'page' : undefined}><span class="nav-num">02</span>{s.tools}</a>
          <a class="lang" href={href(`/${alt}${path}`)} lang={alt} hreflang={alt}>{s.switchTo}</a>
          <button type="button" class="theme" id="theme-toggle" aria-label={s.theme} title={s.theme}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" fill="currentColor"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><p>{s.siteTitle} · {s.soundNote}</p></footer>
    <script>
      import '../widgets/index.ts';
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme !== 'light'; // dark is the default
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>
