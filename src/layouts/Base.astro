---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/golos-text';
import '@fontsource-variable/caveat';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Flag from '../components/Flag.astro';
import { ui, href, other, type Lang } from '../i18n/ui';

// Creator donation page; the QR code points here too.
const SUPPORT_CREATOR_URL = 'https://donatello.to/trskrs';
const CONTACT_EMAIL = 'tkonkevych@gmail.com';
// Defence funds, per language: donate page and logo.
const DEFENCE_FUNDS = [
  {
    name: { en: 'Angar', uk: 'Angar' },
    url: { en: 'https://angarukraine.com/en/support', uk: 'https://angarukraine.com/uk/support' },
    about: { en: 'https://angarukraine.com/en/about', uk: 'https://angarukraine.com/uk/about' },
    logo: { en: '/images/support/angar.svg', uk: '/images/support/angar.svg' },
    desc: 'fundAngar',
    shape: 'tall',
  },
  {
    name: { en: 'Come Back Alive', uk: 'Повернись живим' },
    url: { en: 'https://savelife.in.ua/en/donate-en/#donate-army-card-once', uk: 'https://savelife.in.ua/donate/#donate-army-card-once' },
    about: { en: 'https://savelife.in.ua/en/about-foundation-en/', uk: 'https://savelife.in.ua/about-foundation/' },
    logo: { en: '/images/support/come-back-alive-en.svg', uk: '/images/support/come-back-alive-uk.svg' },
    desc: 'fundComeBackAlive',
    shape: 'wide',
  },
] as const;

interface Props { lang: Lang; title?: string; description?: string; path: string }
const { lang, title, description, path } = Astro.props;
const s = ui[lang];
const fullTitle = title ? `${title} · ${s.siteTitle}` : s.siteTitle;
const alt = other(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? s.tagline} />
    <meta name="theme-color" content="#fff1e8" />
    <link rel="alternate" hreflang={alt} href={href(`/${alt}${path}`)} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <div class="page">
      <slot name="doodles" />
      <header class="site-header">
        <div class="bar">
          <div class="brandbox">
            <a class="brand" href={href(`/${lang}/`)}>{s.siteTitle}</a>
            <p class="made"><span class="scrap">{s.madeInUkraine}</span><Flag /></p>
          </div>
          <nav aria-label="Main">
            <a href={href(`/${lang}/`)} aria-current={path === '/' ? 'page' : undefined}>{s.course}</a>
            <a href={href(`/${lang}/tools/`)} aria-current={path === '/tools/' ? 'page' : undefined}>{s.tools}</a>
            <a class="lang" href={href(`/${alt}${path}`)} lang={alt} hreflang={alt}>{s.switchTo}</a>
          </nav>
        </div>
      </header>
      <main id="main"><slot /></main>
    </div>
    <footer class="site-footer">
      <div class="wrap">
        <div class="ft-cols">
          <div class="ft-about">
            <p class="ft-brand">{s.siteTitle}</p>
            <p>{s.footerAbout}</p>
            <p class="ft-small">{s.credit}</p>
            <p class="ft-small">{s.soundNote}</p>
          </div>
          <nav class="ft-col" aria-label={s.course}>
            <p class="ft-h">{s.course}</p>
            <a href={href(`/${lang}/#contents`)}>{s.contents}</a>
            <a href={href(`/${lang}/tools/`)}>{s.tools}</a>
            <a href={href(`/${alt}${path}`)} lang={alt} hreflang={alt}>{s.switchTo}</a>
          </nav>
          <div class="ft-support">
            <section class="ft-defence" aria-labelledby="ft-defence-h">
              <p class="ft-h" id="ft-defence-h"><Flag size={22} ink="#ffd84a" />{s.supportUkraine}</p>
              <ul class="ft-funds">
                {DEFENCE_FUNDS.map((f) => (
                  <li class="ft-fund">
                    <a class={`ft-fund-logo ft-fund-${f.shape}`} href={f.url[lang]} target="_blank" rel="noopener" aria-label={s.fundDonate.replace('{name}', f.name[lang])}>
                      <img src={href(f.logo[lang])} alt="" loading="lazy" />
                    </a>
                    <div class="ft-fund-text">
                      <p class="ft-note">{s[f.desc]}</p>
                      <a class="ft-fund-more" href={f.about[lang]} target="_blank" rel="noopener">{s.fundAbout} →</a>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
            <section class="ft-creator" aria-labelledby="ft-creator-h">
              <p class="ft-h" id="ft-creator-h">{s.supportCreator}</p>
              <div class="ft-creator-body">
                <a class="ft-qr" href={SUPPORT_CREATOR_URL} target="_blank" rel="noopener">
                  <img src={href('/images/support/qr-creator.svg')} alt={s.supportCreatorQr} width="132" height="132" loading="lazy" />
                </a>
                <div class="ft-creator-text">
                  <p class="ft-note">{s.supportCreatorNote}</p>
                  <a class="ft-btn" href={SUPPORT_CREATOR_URL} target="_blank" rel="noopener">
                    <svg aria-hidden="true" viewBox="0 0 60 60" width="18" style="fill: none; stroke: currentColor; stroke-width: 6; stroke-linecap: round; stroke-linejoin: round"><path d="M30 52C8 36 6 22 14 14c7-6 14-2 16 4 2-6 9-10 16-4 8 8 6 22-16 38z" /></svg>
                    {s.donate}
                  </a>
                </div>
              </div>
            </section>
          </div>
        </div>
        <div class="ft-bottom">
          <p>{s.copyright}</p>
          <p>{s.contactNote} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
        </div>
      </div>
    </footer>
    <script>
      import '../widgets/index.ts';
    </script>
  </body>
</html>
